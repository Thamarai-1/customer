# ==============================================================================
# Root .gitignore - Customer Loyalty and Engagement Assistant
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/
.pnp/
.pnp.js

# Environment Variables & Secrets (Keep secrets out of version control)
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Preserve public .env.example templates
!.env.example
!**/.env.example

# Next.js Build Output & Cache
.next/
frontend/.next/
out/
frontend/out/
.turbo/

# Backend Build Output & Artifacts
dist/
backend/dist/
build/
backend/build/
*.tsbuildinfo

# Testing & Coverage
coverage/
backend/coverage/
frontend/coverage/
*.lcov
.nyc_output/
.vitest/
tmp/
temp/

# Logs
logs/
backend/logs/
frontend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Docker & Database Local Storage
docker-data/
mongo-data/
redis-data/
*.pid
