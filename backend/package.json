  "description": "Backend API for Customer Loyalty and Engagement Assistant",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx src/scripts/seed-all.ts",
    "seed:users": "tsx src/scripts/seed-users.ts",
    "seed:customers": "tsx src/scripts/seed-customers.ts",
    "seed:activities": "tsx src/scripts/seed-activities.ts",
    "seed:billing": "tsx src/scripts/seed-billing.ts",
    "seed:preferences": "tsx src/scripts/seed-preferences.ts",
    "seed:segments": "tsx src/scripts/seed-segments.ts",
    "seed:offers": "tsx src/scripts/seed-offers.ts",
    "seed:campaigns": "tsx src/scripts/seed-campaigns.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "reset:demo": "tsx src/scripts/reset-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.3.0",
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "openai": "^7.57.0",
    "redis": "^4.7.0",
    "zod": "^3.24.1"
