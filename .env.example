# ==============================================================================
# Customer Loyalty and Engagement Assistant - Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development

# Server Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Client-Facing Backend API URL (for Frontend)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Primary Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/customer_engagement_assistant

# Distributed Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379

# Authentication & JWT Configuration
JWT_SECRET=replace_with_secure_access_secret_min_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_min_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# Initial Admin Bootstrap Credentials
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@engagement.hcl.com
ADMIN_PASSWORD=Admin@Secure2026!

# GenAI Providers (Phase 5 Preparation - Do not initialize in Phase 1)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
